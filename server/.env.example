# Flux Community server configuration. Every variable is optional; the values shown are the defaults.
# Copy to server/.env and export them (the server reads process.env only, it does not load .env files):
#   set -a; . server/.env; set +a; npm --prefix server start

# --- listener ---------------------------------------------------------------------------------
PORT=42069
HOST=0.0.0.0
# Built web app. Default is ../web/dist next to server/ (the image sets /app/web).
# WEB_DIST=../web/dist
# debug | info | warn | error | silent. JSON lines on stdout.
LOG_LEVEL=info

# --- security ---------------------------------------------------------------------------------
# Who may name the visitor in X-Forwarded-For. Unset (or fdm) trusts only the Flux domain manager balancers,
# which is right on Flux. false = nobody. 1..9 or true = every peer, that many hops from the right (a reverse
# proxy you run yourself; never when the port is reachable directly). Or a list of addresses and CIDR blocks
# (fdm stands for the Flux balancers): only those peers.
# TRUST_PROXY=fdm
# Browser origins allowed to read the API cross-origin (comma separated), or *. Unset = no CORS headers.
# CORS_ORIGINS=https://example.com
# Add blob: to worker-src (only if the web app starts blob: workers).
# CSP_WORKER_BLOB=0
# Token bucket per client address. /healthz is exempt.
RATE_LIMIT_BURST=150
RATE_LIMIT_RPS=30
# Server-Sent Events caps and slow consumer threshold (bytes queued per client).
SSE_MAX_CLIENTS=2000
SSE_MAX_PER_IP=8
SSE_MAX_BUFFER_BYTES=262144
SSE_HEARTBEAT_MS=20000
# Cap for the in-memory brotli/gzip cache (bytes).
COMPRESS_CACHE_BYTES=33554432

# --- offline mode (dev and CI only, never in production) -----------------------------------------
# 1 = no upstream calls; deterministic simulated data labelled "fallback"; a simulated block every 30 s.
FIXTURES=0

# --- upstreams ----------------------------------------------------------------------------------
# Daemon API bases (comma separated, tried in order), stats service, price API.
FLUX_API_URLS=https://api.runonflux.io
FLUX_STATS_URL=https://stats.runonflux.io
COINGECKO_URL=https://api.coingecko.com
UPSTREAM_TIMEOUT_MS=10000
# UPSTREAM_USER_AGENT=FluxCommunityPortal/2.0 (+https://community.app.runonflux.io)

# --- refresh intervals (ms) ------------------------------------------------------------------------
# Block detection: poll gap while a block is due, and for the ~22 s right after one.
BLOCK_POLL_FAST_MS=1000
BLOCK_POLL_SLOW_MS=3000
# Node counts by tier.
NETWORK_REFRESH_MS=10000
# Capacity, versions and geography (one stats request, about 60 KB brotli).
FLEET_REFRESH_MS=300000
PRICE_REFRESH_MS=60000
# Apps running (~350 KB brotli) and registered (~1.5 MB brotli, conditional request).
APPS_RUNNING_REFRESH_MS=600000
APPS_REGISTERED_REFRESH_MS=1800000

# --- community app health probes -----------------------------------------------------------------
HEALTH_INTERVAL_MS=90000
HEALTH_CONCURRENCY=4
HEALTH_TIMEOUT_MS=8000
HEALTH_MAX_REDIRECTS=3
# 2xx/3xx slower than this is "degraded".
HEALTH_SLOW_MS=2500
# Delay before the confirmation probe after a first failure.
HEALTH_CONFIRM_DELAY_MS=10000
